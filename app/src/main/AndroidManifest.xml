<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 定时锁机 / 开机恢复 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      一键请求「忽略电池优化」。MIUI/HyperOS 上通常等价于把「省电策略」设为「无限制」，
      比让用户手动翻三层菜单快得多。
      注意：该权限在 Google Play 属于政策敏感权限（需说明用途）。本工程是自用/侧载，不涉及上架。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 锁机期间常驻通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      只查询「有启动图标」的应用，读取白名单候选列表已经够用。
      刻意不使用 QUERY_ALL_PACKAGES —— 权限更小，且在 Google Play 上不会触发政策审查。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SelfLockApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SelfLock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          锁机页：即「锁定期间的桌面」。只展示白名单应用的图标。
          singleInstance + taskAffinity="" 保证它不会混进主任务栈，
          excludeFromRecents 保证它不出现在最近任务里（否则用户能从这里溜走）。
        -->
        <activity
            android:name=".lock.LockScreenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.SelfLock.Lock"
            tools:targetApi="27" />

        <!-- 软锁核心：监听前台应用切换，非白名单即踢回锁机页 -->
        <service
            android:name=".lock.LockAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 锁机状态宿主：常驻通知，兼作「锁机中」的可见凭据 -->
        <service
            android:name=".lock.LockForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="维持锁机状态并在锁机期间显示常驻通知，供用户确认状态与手动解除" />
        </service>

        <!-- 设备管理员：激活后可阻止「一键卸载」 -->
        <receiver
            android:name=".lock.DeviceAdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 定时触发点 -->
        <receiver
            android:name=".alarm.ScheduleAlarmReceiver"
            android:exported="false" />

        <!-- 开机 / 时间变更 / 应用升级后重建闹钟 -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
