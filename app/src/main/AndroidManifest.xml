<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 定时锁机 / 开机恢复 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      一键请求「忽略电池优化」。MIUI/HyperOS 上通常等价于把「省电策略」设为「无限制」，
      比让用户手动翻三层菜单快得多。
      注意：该权限在 Google Play 属于政策敏感权限（需说明用途）。本工程是自用/侧载，不涉及上架。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      全屏遮罩用。这是整套锁机里唯一不依赖 Activity 启动的一层：
      按 Home 把锁机页切到后台后，MIUI 会拒绝本应用再拉起任何 Activity
      （logcat: MIUILOG- Permission Denied Activity），而 WindowManager.addView
      不经过 Activity 启动，那道墙管不到。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
      「获取应用列表」。Android 11+ 默认只让应用看到自己 + 在 queries 里声明过的包；
      MIUI 把它单列为一项权限。没有它，queryIntentActivities / getInstalledPackages
      可能返回空集 —— 那会直接让「识别默认桌面」失败，而桌面正是锁机要挡的对象。
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!--
      「使用情况访问」。无障碍之外的第二条「看前台应用」的信号源。
      无障碍服务有「系统说绑定、实际没在收事件」的坑（真机+模拟器都复现过），
      使用情况访问走系统记账，独立一条路。对应系统设置里的「使用情况访问权限」。
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 锁机期间常驻通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      锁机页自己画了一条状态栏（时间 / 网络 / 电量）：悬浮窗铺满全屏之后
      系统状态栏的图标不再绘制，只能自己补齐。读网络类型需要这个权限 ——
      它是 normal 级，安装即授予，不会弹框。
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      锁机页自绘的状态栏要能主动展开下拉栏：悬浮窗整屏可触摸，会把系统自带的
      「从状态栏下拉」手势一起吃掉（矩形窗口没法做局部触摸透传）。
      所以自己识别手势 + 用这个权限展开。它是 normal 级，安装即授予。
      「远离手机」也带这个权限，同一个原因。
    -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!--
      选壁纸时要能看到完整的相册列表。
      系统 Photo Picker 只列它能看的那部分，所以这里读媒体库，
      让它（以及 ACTION_PICK 拉起的相册）能拿到全部图片。
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      用来自动重绑无障碍。这是 signature|privileged|development 级权限：
      普通安装拿不到，只能靠一次 adb 授权 ——
        adb shell pm grant com.waitleisure android.permission.WRITE_SECURE_SETTINGS
      没授权时 App 照常工作，只是要用户手动去设置里开无障碍。
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!--
      只查询「有启动图标」的应用，读取白名单候选列表已经够用。
      刻意不使用 QUERY_ALL_PACKAGES —— 权限更小，且在 Google Play 上不会触发政策审查。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
          解析默认桌面（Launcher）的包名用。
          锁机的核心就是「把桌面挡住」，所以必须知道桌面是谁；
          而 Android 11+ 不在这里声明就查不到其它包，resolveActivity 会返回 null。
          同一个道理：不能把 com.miui.home 写死，换个 ROM 就废了。
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".WaitLeisureApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WaitLeisure">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          锁机页：即「锁定期间的桌面」。只展示白名单应用的图标。
          singleInstance + taskAffinity="" 保证它不会混进主任务栈，
          excludeFromRecents 保证它不出现在最近任务里（否则用户能从这里溜走）。
        -->
        <activity
            android:name=".lock.LockScreenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.WaitLeisure.Lock"
            tools:targetApi="27" />


        <!-- 软锁核心：监听前台应用切换，非白名单即踢回锁机页 -->
        <service
            android:name=".lock.LockAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 锁机状态宿主：常驻通知，兼作「锁机中」的可见凭据 -->
        <service
            android:name=".lock.LockForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="维持锁机状态并在锁机期间显示常驻通知，供用户确认状态与手动解除" />
        </service>

        <!-- 设备管理员：激活后可阻止「一键卸载」 -->
        <receiver
            android:name=".lock.DeviceAdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 定时触发点 -->
        <receiver
            android:name=".alarm.ScheduleAlarmReceiver"
            android:exported="false" />

        <!-- 开机 / 时间变更 / 应用升级后重建闹钟 -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
