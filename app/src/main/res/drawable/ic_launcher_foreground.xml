<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：沙漏。

  两个三角形在**中心一点**相连 —— 上面倒三角尖朝下、下面正三角尖朝上，
  共用顶点 (54,54)。这个形状本身就表达「沙子正在落下」。
  108x108 视口，安全区为中间 72x72。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 上半：倒三角，尖端落在中心点 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,22 L76,22 L54,54 Z" />

    <!-- 下半：正三角，尖端同样落在中心点，与上半共用一个顶点 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,86 L76,86 L54,54 Z" />
</vector>
